# Normaliza fim de linha entre Windows, Linux e macOS.
# Sem isso, cada clone reescreve os arquivos e o Git acusa mudanca falsa.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary
