# =============================================================================
# DRIVER APP - variaveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
# O arquivo .env NUNCA deve ser commitado.
# =============================================================================

# URL do projeto Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica (anon). Pode ir para o aplicativo.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# -----------------------------------------------------------------------------
# PROIBIDO NO APLICATIVO
# -----------------------------------------------------------------------------
# Nunca coloque aqui, nem em nenhum arquivo lido pelo app:
#
#   SUPABASE_SERVICE_ROLE_KEY
#   senha do banco
#   chave privada
#   token de acesso pessoal
#
# Variaveis com prefixo EXPO_PUBLIC_ sao embutidas no bundle e qualquer
# pessoa pode extrai-las do APK. A chave anon e publica por projeto, mas o
# service_role ignora RLS e daria controle total do banco.
# -----------------------------------------------------------------------------
